# Server
PORT=3000
NODE_ENV=production

# Database — path relative to backend/
DB_PATH=./data/reca.db

# JWT — generate strong secrets for production:
# openssl rand -base64 64
JWT_SECRET=change_this_in_production_use_long_random_string_at_least_64_chars
JWT_REFRESH_SECRET=change_this_too_must_be_different_from_jwt_secret_also_64_chars

# Token expiry
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS — set to your production domain (no trailing slash)
# Example: https://tudominio.com
ALLOWED_ORIGIN=https://tudominio.com

# One-time setup key — required to create the Super Admin account
# Generate with: openssl rand -hex 16
# IMPORTANT: remove or rotate this after first setup
SETUP_KEY=change_this_to_a_random_secret_before_running_setup

# SMTP for password reset emails (optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM=RE.CA Platform <noreply@example.com>
