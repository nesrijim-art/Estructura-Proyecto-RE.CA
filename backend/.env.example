# Server
PORT=3000
NODE_ENV=development

# Database
DB_PATH=./data/reca.db

# JWT — generate strong secrets for production
# openssl rand -base64 64
JWT_SECRET=change_this_in_production_use_long_random_string_at_least_64_chars
JWT_REFRESH_SECRET=change_this_too_must_be_different_from_jwt_secret_also_64_chars

# Token expiry
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Static files root (relative to backend/)
STATIC_ROOT=../

# In production: configure SMTP for password reset emails
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM=RE.CA Platform <noreply@example.com>
